{
  "name": "layout",
  "extends": "port",
  "about": "The port theme plus a different workspace layout: renamed directories and operator / data files, token ids CRED-… instead of TOK-…, incidents CASE-… instead of INC-…. Measures what the harness's hard-coded paths and id formats cost. /AGENTS.md and /drafts/ stay: the Task API docs fix those two.",
  "token_prefix": "CRED",

  "literals": {
    "/fleet": "/crew",
    "/board": "/channel",
    "/logs/audit": "/logs/gateway",
    "/logs/archive": "/logs/rotated",
    "/logs/access": "/logs/requests",
    "/plans": "/response",
    "/integrations/mcp": "/connectors/mcp",
    "/integrations": "/connectors",
    "/artifacts/quarantine": "/evidence/quarantine",
    "/artifacts": "/evidence",
    "/security": "/secops",
    "/tickets": "/queue",
    "/intel": "/threat",

    "agents.csv": "roster.csv",
    "tokens.csv": "credentials.csv",
    "token_fingerprints.csv": "credential_hashes.csv",
    "registry_export.json": "directory_export.json",
    "changes.md": "iam_log.md",
    "swarm_board.jsonl": "posts.jsonl",
    "contacts.csv": "address_book.csv",
    "runbook.md": "playbook.md",
    "runbook": "playbook",
    "runbooks": "playbooks",
    "standing_order": "night_order",
    "standing order": "night order",
    "standing orders": "night orders",
    "egress_export": "transfer_register",
    "containment.json": "containment_state.json",
    "pending_access_requests.csv": "access_queue.csv",
    "access_policy.md": "access_rules.md",
    "canaries.csv": "honeytokens.csv",
    "paste_dump.txt": "pastebin_copy.txt",
    "siem_alerts": "alerts",
    "change_calendar.csv": "freeze_calendar.csv",
    "enterprise_accounts.csv": "customer_agreements.csv",

    "TOK-": "CRED-",
    "TOK-DAT-": "CRED-MAN-",
    "TOK-SPA-": "CRED-BER-",
    "TOK-HUB-": "CRED-TRM-",
    "TOK-VAU-": "CRED-KEY-",
    "TOK-SUP-": "CRED-HLP-",
    "TOK-BIL-": "CRED-INV-",
    "INC-MF": "CASE-SM",
    "inc-mf": "case-sm",
    "INC-": "CASE-"
  }
